<?xml version="1.0"?>
<sdf version="1.8">
  <world name="lab">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.42 0.42 0.42 1</ambient>
      <background>0.85 0.88 0.9 1</background>
      <shadows>true</shadows>
    </scene>
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <ignition-gui><title>3D View</title><property type="bool" key="showTitleBar">false</property><property type="string" key="state">docked</property></ignition-gui>
        <engine>ogre2</engine><scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light><background_color>0.85 0.88 0.9</background_color>
        <camera_pose>0.38 -0.58 0.39 0 0.524 1.5708</camera_pose>
        <camera_clip><near>0.03</near><far>100</far></camera_clip>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <ignition-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></ignition-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <ignition-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></ignition-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <ignition-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></ignition-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <ignition-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></ignition-gui>
      </plugin>
      <plugin filename="MarkerManager" name="Marker manager">
        <ignition-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></ignition-gui>
      </plugin>
      <plugin filename="SelectEntities" name="Select Entities">
        <ignition-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></ignition-gui>
      </plugin>
      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <ignition-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></ignition-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <ignition-gui><title>World control</title><property type="bool" key="showTitleBar">false</property><property type="bool" key="resizable">false</property><property type="double" key="height">72</property><property type="double" key="width">121</property><property type="double" key="z">1</property><property type="string" key="state">floating</property>
          <anchors target="3D View"><line own="left" target="left"/><line own="bottom" target="bottom"/></anchors></ignition-gui>
        <play_pause>true</play_pause><step>true</step><start_paused>false</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <ignition-gui><title>World stats</title><property type="bool" key="showTitleBar">false</property><property type="bool" key="resizable">false</property><property type="double" key="height">110</property><property type="double" key="width">290</property><property type="double" key="z">1</property><property type="string" key="state">floating</property>
          <anchors target="3D View"><line own="right" target="right"/><line own="bottom" target="bottom"/></anchors></ignition-gui>
        <sim_time>true</sim_time><real_time>true</real_time><real_time_factor>true</real_time_factor><iterations>true</iterations>
      </plugin>
    </gui>
    <light type="directional" name="ceiling">
      <pose>0.3 -0.5 3 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.55 0.55 0.53 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.15 0.35 -0.92</direction>
    </light>
    <light type="point" name="fill">
      <pose>0.4 -1.2 1.4 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.25 0.25 0.25 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation><range>8</range><constant>0.6</constant><linear>0.05</linear><quadratic>0.0</quadratic></attenuation>
    </light>
    
    <include>
      <uri>model://lab_room</uri>
      <name>lab_room</name>
      <pose>0 0 0 0 0 0</pose><static>true</static>
    </include>
    
    <include>
      <uri>model://lab_table</uri>
      <name>lab_table</name>
      <pose>0 0 0 0 0 0</pose><static>true</static>
    </include>
    
    <model name="lab_camera">
      <static>true</static>
      <pose>0.38 -0.58 0.39 0 0.524 1.5708</pose>
      <link name="link">
        <sensor name="rgb" type="camera">
          <always_on>1</always_on>
          <update_rate>5</update_rate>
          <topic>/lab_camera/image</topic>
          <camera>
            <horizontal_fov>1.48</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>20</far></clip>
            
          </camera>
        </sensor>
      </link>
    </model>

    <include>
      <uri>model://basket</uri>
      <name>basket</name>
      <pose>0.552252 0.0123056 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://yellow_block</uri>
      <name>yellow_block</name>
      <pose>0.538631 -0.0241408 0.0309991 -7.68951e-09 1.97521e-08 -2.2997</pose>
    </include>
    <include>
      <uri>model://roll_of_black_tape</uri>
      <name>roll_of_black_tape</name>
      <pose>0.259075 0.192479 0.0124991 -1.5246e-17 7.48452e-19 -2.73667</pose>
    </include>
    <include>
      <uri>model://red_can</uri>
      <name>red_can</name>
      <pose>0.206453 -0.103463 0.0724991 4.4963e-19 1.20488e-18 0.0636836</pose>
    </include>
    <include>
      <uri>model://red_spray_bottle</uri>
      <name>red_spray_bottle</name>
      <pose>0.272944 0.0391799 0.134999 -8.59209e-20 7.02531e-10 2.00232</pose>
    </include>
    <include>
      <uri>model://blue_cup_with_yellow_stripe</uri>
      <name>blue_cup_with_yellow_stripe</name>
      <pose>0.193077 -0.193074 0.0599991 -4.14587e-18 -4.7553e-18 0.0647296</pose>
    </include>
    <include>
      <uri>model://red_block</uri>
      <name>red_block</name>
      <pose>0.158725 0.173349 0.0249991 -5.60455e-18 -1.93124e-18 -2.89361</pose>
    </include>
    <include>
      <uri>model://green_block</uri>
      <name>green_block</name>
      <pose>0.653698 -0.229544 0.0249991 2.70254e-18 -4.9807e-18 -1.21163</pose>
    </include>
    <include>
      <uri>model://blue_block</uri>
      <name>blue_block</name>
      <pose>0.37289 0.213712 0.0249991 3.81854e-18 6.92854e-18 -0.678181</pose>
    </include>
    <include>
      <uri>model://orange_block</uri>
      <name>orange_block</name>
      <pose>0.67103 0.21578 0.0199991 5.00041e-18 -5.00477e-18 1.40005</pose>
    </include>
    <include>
      <uri>model://roll_of_green_tape</uri>
      <name>roll_of_green_tape</name>
      <pose>0.421218 -0.215261 0.00999913 -2.49728e-18 -8.68963e-18 -3.07191</pose>
    </include>
    <include>
      <uri>model://green_mug</uri>
      <name>green_mug</name>
      <pose>0.30724 -0.08467 0.0449991 2.36252e-19 8.72891e-09 -0.593545</pose>
    </include>
    <include>
      <uri>model://roll_of_blue_tape</uri>
      <name>roll_of_blue_tape</name>
      <pose>0.299941 -0.200926 0.0239991 4.50589e-18 7.42137e-18 2.24115</pose>
    </include>
  </world>
</sdf>
