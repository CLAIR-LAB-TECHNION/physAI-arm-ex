<?xml version="1.0"?>
<!--
  The lab robot: UR arm on its mounting plate, OnRobot Quick Changer and RG6.
  Robot type, mounting pose, start pose (home_joints) and grip force come
  from config/cell.yaml (sections robot and gripper).

  sim_ignition:=true adds ros2_control for Gazebo (arm and gripper).
  Without it the file describes the real cell for robot_state_publisher.
  (No colons followed by a space in comments here. ur_simulation_gz style
  launch files parse the description as YAML.)
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur">
  <xacro:arg name="ur_type" default="ur5e"/>
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="sim_ignition" default="false"/>
  <xacro:arg name="use_fake_hardware" default="false"/>
  <xacro:arg name="simulation_controllers" default=""/>
  <xacro:arg name="robot_ip" default="0.0.0.0"/>
  <xacro:arg name="headless_mode" default="false"/>
  <xacro:arg name="safety_limits" default="false"/>
  <xacro:arg name="cell_file" default="$(find lab_replica)/config/cell.yaml"/>
  <xacro:arg name="wrist_camera_rate" default="0"/>  <!-- Hz; 0: cell.yaml -->

  <xacro:property name="cell" value="${xacro.load_yaml('$(arg cell_file)')}"/>
  <xacro:property name="rb" value="${cell['robot']}"/>
  <xacro:property name="gr" value="${cell['gripper']}"/>
  <xacro:property name="hj" value="${rb['home_joints']}"/>
  <xacro:property name="ur_type" value="$(arg ur_type)"/>

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find lab_replica)/description/urdf/rg6.xacro"/>

  <link name="world"/>

  <xacro:ur_robot
    name="ur"
    tf_prefix="$(arg tf_prefix)"
    parent="world"
    joint_limits_parameters_file="$(find ur_description)/config/${ur_type}/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/${ur_type}/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/${ur_type}/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/${ur_type}/visual_parameters.yaml"
    safety_limits="$(arg safety_limits)"
    use_fake_hardware="$(arg use_fake_hardware)"
    sim_ignition="$(arg sim_ignition)"
    headless_mode="$(arg headless_mode)"
    robot_ip="$(arg robot_ip)"
    ur_type="${ur_type}"
    initial_positions="${dict(shoulder_pan_joint=hj[0], shoulder_lift_joint=hj[1], elbow_joint=hj[2], wrist_1_joint=hj[3], wrist_2_joint=hj[4], wrist_3_joint=hj[5])}">
    <origin xyz="${rb['base_xyz'][0]} ${rb['base_xyz'][1]} ${rb['base_xyz'][2]}" rpy="0 0 ${rb['base_yaw']}"/>
  </xacro:ur_robot>

  <!-- OnRobot Quick Changer, robot side. -->
  <link name="$(arg tf_prefix)quick_changer">
    <inertial>
      <origin xyz="0 0 ${gr['quick_changer_thickness'] / 2}"/>
      <mass value="0.1"/>
      <inertia ixx="5e-5" ixy="0" ixz="0" iyy="5e-5" iyz="0" izz="8e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${gr['quick_changer_thickness'] / 2}"/>
      <geometry><cylinder radius="0.0375" length="${gr['quick_changer_thickness']}"/></geometry>
      <material name="qc_dark"><color rgba="0.25 0.27 0.30 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${gr['quick_changer_thickness'] / 2}"/>
      <geometry><cylinder radius="0.0375" length="${gr['quick_changer_thickness']}"/></geometry>
    </collision>
  </link>
  <joint name="$(arg tf_prefix)quick_changer_joint" type="fixed">
    <parent link="$(arg tf_prefix)tool0"/>
    <child link="$(arg tf_prefix)quick_changer"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:rg6 prefix="$(arg tf_prefix)" parent="$(arg tf_prefix)quick_changer"
             grip_force="${gr['grip_force']}" sim_ignition="$(arg sim_ignition)">
    <origin xyz="0 0 ${gr['quick_changer_thickness']}" rpy="0 0 ${gr['mount_yaw']}"/>
  </xacro:rg6>

  <!-- Wrist RealSense (cell.yaml section wrist_camera). The colour optical
       frame is placed as measured (hand-eye calibration); the camera body
       frame wrist_camera_link follows the RealSense convention (x along the
       view, y left, z up), so optical = link turned by rpy (-pi/2, 0, -pi/2). -->
  <xacro:property name="wc" value="${cell['wrist_camera']}"/>
  <link name="$(arg tf_prefix)wrist_camera_color_optical_frame"/>
  <joint name="$(arg tf_prefix)wrist_camera_optical_joint" type="fixed">
    <parent link="$(arg tf_prefix)rg6_base_link"/>
    <child link="$(arg tf_prefix)wrist_camera_color_optical_frame"/>
    <origin xyz="${wc['optical_xyz'][0]} ${wc['optical_xyz'][1]} ${wc['optical_xyz'][2]}"
            rpy="${wc['optical_rpy'][0]} ${wc['optical_rpy'][1]} ${wc['optical_rpy'][2]}"/>
  </joint>
  <link name="$(arg tf_prefix)wrist_camera_link">
    <inertial>
      <mass value="0.07"/>
      <inertia ixx="5e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="5e-5"/>
    </inertial>
    <visual>
      <origin xyz="${-wc['housing'][0] / 2} 0 0"/>
      <geometry><box size="${wc['housing'][0]} ${wc['housing'][1]} ${wc['housing'][2]}"/></geometry>
      <material name="realsense_grey"><color rgba="0.55 0.56 0.58 1"/></material>
    </visual>
    <collision>
      <origin xyz="${-wc['housing'][0] / 2} 0 0"/>
      <geometry><box size="${wc['housing'][0]} ${wc['housing'][1]} ${wc['housing'][2]}"/></geometry>
    </collision>
  </link>
  <joint name="$(arg tf_prefix)wrist_camera_link_joint" type="fixed">
    <parent link="$(arg tf_prefix)wrist_camera_color_optical_frame"/>
    <child link="$(arg tf_prefix)wrist_camera_link"/>
    <origin xyz="0 0 0" rpy="0 -1.570796 1.570796"/>
  </joint>

  <xacro:if value="$(arg sim_ignition)">
    <!-- The simulated RealSense: colour and depth from one rgbd sensor, so
         the depth image is aligned to the colour image like the driver's
         aligned_depth_to_color. Its frame is x along the view, as
         wrist_camera_link. sim.launch.py bridges it to the RealSense
         topic names. -->
    <gazebo reference="$(arg tf_prefix)wrist_camera_link">
      <sensor name="wrist_camera" type="rgbd_camera">
        <always_on>1</always_on>
        <update_rate>${wc['update_rate'] if float('$(arg wrist_camera_rate)') &lt;= 0 else float('$(arg wrist_camera_rate)')}</update_rate>
        <topic>wrist_camera</topic>
        <camera>
          <horizontal_fov>${wc['horizontal_fov']}</horizontal_fov>
          <image><width>${wc['width']}</width><height>${wc['height']}</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>10</far></clip>
          <depth_camera><clip><near>${wc['depth_range'][0]}</near><far>${wc['depth_range'][1]}</far></clip></depth_camera>
        </camera>
      </sensor>
    </gazebo>
  </xacro:if>

  <xacro:if value="$(arg sim_ignition)">
    <gazebo>
      <plugin filename="libign_ros2_control-system.so" name="ign_ros2_control::IgnitionROS2ControlPlugin">
        <parameters>$(arg simulation_controllers)</parameters>
        <controller_manager_node_name>$(arg tf_prefix)controller_manager</controller_manager_node_name>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
